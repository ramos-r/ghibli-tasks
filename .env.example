# Neon Postgres — pooled connection, used as the runtime connection string
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Neon Postgres — unpooled/direct connection, used by Prisma for migrations
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"
